{
  "installation": {
    "version": "19.0.1",
    "plugins": {
      "@nx/next": "19.0.1",
      "@nx-go/nx-go": "3.0.0"
    }
  },
  "plugins": [
    "@nx-go/nx-go",
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": {
          "name": "docker:build"
        },
        "runTarget": {
          "name": "docker:run"
        }
      }
    }
  ],
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/go.work"]
  }
}
